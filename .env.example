# Postgres connection string from Neon (Vercel -> Storage -> Create Database).
# Leave this unset locally and the shop uses an embedded Postgres in data/pg.
DATABASE_URL=

# Vercel Blob token, for product photo uploads in production.
# Leave unset locally and photos are written to public/uploads.
BLOB_READ_WRITE_TOKEN=

# Seeded on first run only. Change the password in Settings afterwards.
ADMIN_EMAIL=admin@flowerbutik.dk
ADMIN_PASSWORD=admin1234

# Set to 1 once the site is served over HTTPS.
SECURE_COOKIES=1
