# Postgres connection string. On Vercel this is set for you when you attach a
# Neon database (Storage -> Create Database -> Neon). Leave it unset locally and
# the shop uses an embedded Postgres in data/pg with nothing to install.
DATABASE_URL=

# Vercel Blob token, for product and slideshow photo uploads in production.
# Set for you when you attach a Blob store. Leave unset locally and photos are
# written to public/uploads instead.
BLOB_READ_WRITE_TOKEN=

# The admin account created on the very first run. Change the password in
# Settings afterwards; changing these later does not affect an existing account.
ADMIN_EMAIL=admin@phoolmaya.com
ADMIN_PASSWORD=change-me-before-deploying

# Set to 1 once the site is served over HTTPS, so the admin session cookie is
# only ever sent over a secure connection.
SECURE_COOKIES=1

# 0 starts with an empty catalogue. Leave it unset (or 1) and the first run
# seeds twelve sample bouquets, which is handy locally but not on a real shop.
SEED_SAMPLE_DATA=0
